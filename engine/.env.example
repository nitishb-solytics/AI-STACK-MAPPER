# Copy this file to `.env` in the same directory (engine/) and fill it in.
# `.env` is gitignored -- never commit your real API key.
#
# This configures the *scanner tool itself* (optional AI enrichment), not
# the repo being scanned. It has nothing to do with a target repo's own
# .env/.env.example files, which are scanned separately for LLM-related key
# NAMES only (never values) as a static AI-stack signal.

# Set to true to enable optional LLM-powered enrichment (Model
# Purpose/Usage/Expected Output per component) without passing --enrich on
# every run. Leave false (or unset) to use the plain static AST scanner only.
AI_STACK_USE_LLM=false

# Required if AI_STACK_USE_LLM=true. Falls back to $OPENAI_API_KEY if unset.
AI_STACK_LLM_API_KEY=

# OpenAI-compatible chat-completions base URL. Leave blank for the default
# (https://api.openai.com/v1). Point this at a self-hosted/on-prem endpoint
# (vLLM, Ollama, internal Azure OpenAI, LiteLLM proxy) instead if code
# confidentiality matters -- code context never has to leave your network.
AI_STACK_LLM_BASE_URL=

# Model name to request.
AI_STACK_LLM_MODEL=gpt-4o-mini
