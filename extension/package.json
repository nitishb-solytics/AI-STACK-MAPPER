{
  "name": "ai-stack-mapper",
  "displayName": "AI Stack Mapper",
  "description": "Discover local AI agents in a codebase and publish them to Vault AI Governance Auto Discovery.",
  "version": "0.1.0",
  "publisher": "local-dev",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other", "Visualization"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiStackMapper.scan",
        "title": "AI Stack: Scan Workspace",
        "icon": "$(refresh)"
      },
      {
        "command": "aiStackMapper.exportMarkdown",
        "title": "AI Stack: Export Markdown Report"
      },
      {
        "command": "aiStackMapper.publishToVault",
        "title": "AI Stack: Publish Local Agent Discovery to Vault",
        "icon": "$(cloud-upload)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiStackMapper",
          "title": "AI Stack",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "aiStackMapper": [
        {
          "id": "aiStackMapperView",
          "name": "Components"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "aiStackMapper.scan",
          "when": "view == aiStackMapperView",
          "group": "navigation"
        },
        {
          "command": "aiStackMapper.publishToVault",
          "when": "view == aiStackMapperView",
          "group": "navigation"
        }
      ]
    },
    "configuration": {
      "title": "AI Stack Mapper",
      "properties": {
        "aiStackMapper.pythonPath": {
          "type": "string",
          "default": "python3",
          "description": "Path to the Python 3 interpreter used to run the scanner (must be 3.8+)."
        },
        "aiStackMapper.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically re-scan (debounced) when a relevant file is saved."
        },
        "aiStackMapper.vaultBaseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:8000",
          "description": "Vault backend base URL used by 'AI Stack: Publish Discovery to Vault'."
        },
        "aiStackMapper.vaultOrg": {
          "type": "string",
          "default": "",
          "description": "Vault Org header / tenant account id used by 'AI Stack: Publish Discovery to Vault'."
        },
        "aiStackMapper.vaultRepoUrl": {
          "type": "string",
          "default": "",
          "description": "Optional repository URL metadata sent to Vault when publishing scanner results."
        },
        "aiStackMapper.vaultBranch": {
          "type": "string",
          "default": "",
          "description": "Optional repository branch metadata sent to Vault when publishing scanner results."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.4.5"
  }
}
